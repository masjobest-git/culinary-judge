
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/panel.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

  <title>Judge Dashboard | Culinary Judge</title>
</head>

<body class="admin-page judge-page">

  <div class="dashboard-layout">

    <!-- Sidebar -->
    <aside class="dashboard-sidebar">

      <a href="/" class="dashboard-brand">
        <i class="fa-solid fa-utensils"></i>
        <span>Culinary Judge</span>
      </a>

      <p class="dashboard-menu-label">MAIN MENU</p>

      <a href="/judge" class="dashboard-nav-link active">
        <i class="fa-solid fa-house"></i>
        <span>Dashboard</span>
      </a>

      <a href="/competitors" class="dashboard-nav-link">
        <i class="fa-solid fa-users"></i>
        <span>Competitors</span>
      </a>

      <a href="/evaluations/results" class="dashboard-nav-link">
        <i class="fa-solid fa-clipboard-check"></i>
        <span>My Evaluation Results</span>
      </a>

      <div class="dashboard-sidebar-spacer"></div>

      <a href="/" class="dashboard-nav-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Home</span>
      </a>

      <form action="/auth/logout" method="POST">
        <button type="submit" class="dashboard-nav-link dashboard-logout">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Logout</span>
        </button>
      </form>

    </aside>

    <!-- Main content -->
    <div class="dashboard-main">

      <header class="dashboard-topbar">
        <div>
          <span class="dashboard-breadcrumb">Culinary Judge /</span>
          <strong>Judge Dashboard</strong>
        </div>

        <div class="dashboard-admin-label">
          <i class="fa-solid fa-gavel"></i>
          <span>Judge Panel</span>
        </div>
      </header>

      <main class="dashboard-content">

        <div class="dashboard-welcome">
          <div>
            <p class="dashboard-eyebrow">JUDGE WORKSPACE</p>
            <h1>Welcome to Culinary Judge!</h1>
            <p>Manage your evaluations and review competition results.</p>
          </div>

          <div class="dashboard-welcome-icon">
            <i class="fa-solid fa-gavel"></i>
          </div>
        </div>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          <div class="error-message">
            <%= errorMessage %>
          </div>
        <% } %>

        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
          <div class="success-message">
            <%= successMessage %>
          </div>
        <% } %>

        <!-- Dashboard cards -->
        <div class="judge-dashboard-cards">

          <section class="judge-dashboard-card">
            <div class="judge-dashboard-card-icon">
              <i class="fa-solid fa-clipboard-list"></i>
            </div>

            <h2>Evaluations</h2>
            <p>Open the competitors list to select a competitor and start an evaluation.</p>

            <a href="/competitors" class="panel-primary-button">
              <i class="fa-solid fa-arrow-right"></i>
              View Competitors
            </a>
          </section>

          <section class="judge-dashboard-card">
            <div class="judge-dashboard-card-icon">
              <i class="fa-solid fa-chart-column"></i>
            </div>

            <h2>My Evaluation Results</h2>
            <p>Review your submitted scores and see the available evaluation results.</p>

            <a href="/evaluations/results" class="panel-primary-button">
              <i class="fa-solid fa-arrow-right"></i>
              View My Results
            </a>
          </section>

        </div>

      </main>

    </div>

  </div>

</body>
</html>
