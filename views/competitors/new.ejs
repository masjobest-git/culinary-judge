
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>New Competitor</title>
</head>
<body>
  <h1>Add Competitor</h1>

  <form action="/competitors" method="POST">
    <label for="name">Name:</label>
    <input type="text" id="name" name="name" required>

    <label for="school">School:</label>
    <input type="text" id="school" name="school" required>

    <button type="submit">Add Competitor</button>
  </form>

  <a href="/competitors">Back to Competitors</a>
</body>
</html>
