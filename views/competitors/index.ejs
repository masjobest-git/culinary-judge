

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/css/style.css">
  <title>Competitors</title>
</head>
<body>

  <%- include('../partials/navbar') %>

  <h1>Competitors</h1>

  <a href="/competitors/new">Add Competitor</a>

  <ul>
    <% competitors.forEach((competitor) => { %>
      <li>
        <%= competitor.name %> - <%= competitor.school %>

        <a href="/evaluations/new/<%= competitor._id %>">Evaluate</a>

        <a href="/competitors/<%= competitor._id %>/edit">Edit</a>

        <form action="/competitors/<%= competitor._id %>/delete" method="POST" style="display: inline;">
          <button type="submit" onclick="return confirm('Are you sure you want to delete this competitor?')">Delete</button>
        </form>
      </li>
    <% }) %>
  </ul>

</body>
</html>
