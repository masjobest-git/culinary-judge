<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/panel.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

  <title>Competitors | Culinary Judge</title>
</head>

<body class="admin-page">
  <div class="dashboard-layout">

    <aside class="dashboard-sidebar">
      <a href="/" class="dashboard-brand">
        <i class="fa-solid fa-utensils"></i>
        <span>Culinary Judge</span>
      </a>

      <p class="dashboard-menu-label">MAIN MENU</p>

      <% const isAdmin = typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin'; %>

      <% if (isAdmin) { %>
        <a href="/admin" class="dashboard-nav-link">
          <i class="fa-solid fa-house"></i>
          <span>Dashboard</span>
        </a>

        <a href="/competitors" class="dashboard-nav-link active">
          <i class="fa-solid fa-users"></i>
          <span>Competitors</span>
        </a>

        <a href="/admin/judges" class="dashboard-nav-link">
          <i class="fa-solid fa-user-check"></i>
          <span>Judges</span>
        </a>

        <a href="/admin/scoring-groups" class="dashboard-nav-link">
          <i class="fa-solid fa-list-check"></i>
          <span>Scoring Groups</span>
        </a>

        <a href="/admin/ranking" class="dashboard-nav-link">
          <i class="fa-solid fa-trophy"></i>
          <span>Final Ranking</span>
        </a>
      <% } else { %>
        <a href="/judge" class="dashboard-nav-link">
          <i class="fa-solid fa-house"></i>
          <span>Dashboard</span>
        </a>

        <a href="/competitors" class="dashboard-nav-link active">
          <i class="fa-solid fa-users"></i>
          <span>Competitors</span>
        </a>

        <a href="/evaluations/results" class="dashboard-nav-link">
          <i class="fa-solid fa-clipboard-check"></i>
          <span>My Evaluation Results</span>
        </a>
      <% } %>

      <div class="dashboard-sidebar-spacer"></div>

      <a href="/" class="dashboard-nav-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Home</span>
      </a>

      <form action="/auth/logout" method="POST">
        <button type="submit" class="dashboard-nav-link dashboard-logout">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Logout</span>
        </button>
      </form>
    </aside>

    <div class="dashboard-main">

      <header class="dashboard-topbar">
        <div>
          <span class="dashboard-breadcrumb">Culinary Judge /</span>
          <strong>Competitors</strong>
        </div>

        <div class="dashboard-admin-label">
          <i class="fa-solid fa-users"></i>
          <span>Competition Management</span>
        </div>
      </header>

      <main class="dashboard-content">

        <div class="dashboard-welcome">
          <div>
            <p class="dashboard-eyebrow">COMPETITION MANAGEMENT</p>
            <h1>Competitors</h1>
            <p>View, add, edit and evaluate competition participants.</p>
          </div>

          <div class="dashboard-welcome-icon">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>

        <div class="competitors-toolbar">
          <h2 class="dashboard-section-title">All Competitors</h2>

          <% if (isAdmin) { %>
            <a href="/competitors?new=true" class="panel-primary-button">
              <i class="fa-solid fa-plus"></i>
              Add New Competitor
            </a>
          <% } %>
        </div>

        <% if (typeof showNewForm !== 'undefined' && showNewForm && isAdmin) { %>
          <div class="competitors-table-card">
            <h2 class="dashboard-section-title">Add New Competitor</h2>

            <form action="/competitors" method="POST" class="competitor-inline-edit">
              <div class="competitor-form-field">
                <label for="new-name">Full Name</label>
                <input type="text" id="new-name" name="name" required>
              </div>

              <div class="competitor-form-field">
                <label for="new-school">School</label>
                <input type="text" id="new-school" name="school" required>
              </div>

              <div class="competitor-form-field">
                <label for="new-box">BOX Number</label>
                <input type="number" id="new-box" name="box" min="1" step="1" required>
              </div>

              <div class="competitor-form-buttons">
                <button type="submit" class="panel-primary-button">
                  <i class="fa-solid fa-check"></i>
                  Save Competitor
                </button>

                <a href="/competitors" class="panel-action-button edit">
                  Cancel
                </a>
              </div>
            </form>
          </div>
        <% } %>

        <div class="competitors-table-card">
          <table class="panel-table">
            <thead>
              <tr>
                <th>Full Name</th>
                <th>School</th>
                <th>BOX</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% competitors.forEach((competitor) => { %>
                <tr>
                  <% if (
                    typeof editCompetitor !== 'undefined' &&
                    editCompetitor &&
                    editCompetitor._id.toString() === competitor._id.toString() &&
                    isAdmin
                  ) { %>

                    <td colspan="4">
                      <form
                        action="/competitors/<%= competitor._id %>/edit"
                        method="POST"
                        class="competitor-inline-edit"
                      >

                        <div class="competitor-form-field">
                          <label for="name-<%= competitor._id %>">Full Name</label>
                          <input
                            type="text"
                            id="name-<%= competitor._id %>"
                            name="name"
                            value="<%= competitor.name %>"
                            required
                          >
                        </div>

                        <div class="competitor-form-field">
                          <label for="school-<%= competitor._id %>">School</label>
                          <input
                            type="text"
                            id="school-<%= competitor._id %>"
                            name="school"
                            value="<%= competitor.school %>"
                            required
                          >
                        </div>

                        <div class="competitor-form-field">
                          <label for="box-<%= competitor._id %>">BOX Number</label>
                          <input
                            type="number"
                            id="box-<%= competitor._id %>"
                            name="box"
                            value="<%= competitor.box %>"
                            min="1"
                            step="1"
                            required
                          >
                        </div>

                        <div class="competitor-form-buttons">
                          <button type="submit" class="panel-primary-button">
                            <i class="fa-solid fa-check"></i>
                            Save
                          </button>

                          <a href="/competitors" class="panel-action-button edit">
                            Cancel
                          </a>
                        </div>

                      </form>
                    </td>

                  <% } else { %>

                    <td>
                      <div class="competitor-name">
                        <span class="competitor-avatar">
                          <i class="fa-solid fa-user"></i>
                        </span>
                        <strong><%= competitor.name %></strong>
                      </div>
                    </td>

                    <td><%= competitor.school %></td>

                    <td>
                      <% if (competitor.box) { %>
                        <span class="box-label">
                          BOX <%= competitor.box %>
                        </span>
                      <% } else { %>
                        -
                      <% } %>
                    </td>

                    <td>
                      <div class="panel-actions">

                        <a
                          href="/evaluations/new/<%= competitor._id %>"
                          class="panel-action-button evaluate"
                        >
                          <i class="fa-solid fa-clipboard-check"></i>
                          Evaluate
                        </a>

                        <% if (isAdmin) { %>
                          <a
                            href="/competitors?edit=<%= competitor._id %>"
                            class="panel-action-button edit"
                          >
                            <i class="fa-solid fa-pen"></i>
                            Edit
                          </a>

                          <form
                            action="/competitors/<%= competitor._id %>/delete"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this competitor?')"
                          >
                            <button type="submit" class="panel-action-button delete">
                              <i class="fa-solid fa-trash"></i>
                              Delete
                            </button>
                          </form>
                        <% } %>

                      </div>
                    </td>

                  <% } %>
                </tr>
              <% }) %>

              <% if (competitors.length === 0) { %>
                <tr>
                  <td colspan="4" class="panel-empty-state">
                    No competitors have been added yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </main>
    </div>
  </div>
</body>
</html>