<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/panel.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <title>Judges | Culinary Judge</title>
</head>

<body class="admin-page">
  <div class="dashboard-layout">

    <aside class="dashboard-sidebar">
      <a href="/" class="dashboard-brand">
        <i class="fa-solid fa-utensils"></i>
        <span>Culinary Judge</span>
      </a>

      <p class="dashboard-menu-label">MAIN MENU</p>

      <a href="/admin" class="dashboard-nav-link">
        <i class="fa-solid fa-house"></i>
        <span>Dashboard</span>
      </a>

      <a href="/competitors" class="dashboard-nav-link">
        <i class="fa-solid fa-users"></i>
        <span>Competitors</span>
      </a>

      <a href="/admin/judges" class="dashboard-nav-link active">
        <i class="fa-solid fa-user-check"></i>
        <span>Judges</span>
      </a>

      <a href="/admin/ranking" class="dashboard-nav-link">
        <i class="fa-solid fa-trophy"></i>
        <span>Final Ranking</span>
      </a>

      <div class="dashboard-sidebar-spacer"></div>

      <a href="/" class="dashboard-nav-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Home</span>
      </a>

      <form action="/auth/logout" method="POST">
        <button type="submit" class="dashboard-nav-link dashboard-logout">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Logout</span>
        </button>
      </form>
    </aside>

    <div class="dashboard-main">

      <header class="dashboard-topbar">
        <div>
          <span class="dashboard-breadcrumb">Culinary Judge /</span>
          <strong>Judges</strong>
        </div>

        <div class="dashboard-admin-label">
          <i class="fa-solid fa-user-check"></i>
          <span>Competition Management</span>
        </div>
      </header>

      <main class="dashboard-content">

        <div class="dashboard-welcome">
          <div>
            <p class="dashboard-eyebrow">COMPETITION MANAGEMENT</p>
            <h1>Judges</h1>
            <p>View, add, edit and manage judge accounts.</p>
          </div>

          <div class="dashboard-welcome-icon">
            <i class="fa-solid fa-user-check"></i>
          </div>
        </div>

        <div class="competitors-toolbar">
          <h2 class="dashboard-section-title">All Judges</h2>

          <a href="/admin/judges?new=true" class="panel-primary-button">
            <i class="fa-solid fa-plus"></i>
            Add New Judge
          </a>
        </div>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          <div class="error-message">
            <%= errorMessage %>
          </div>
        <% } %>

        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
          <div class="success-message">
            <%= successMessage %>
          </div>
        <% } %>

        <% if (typeof showNewForm !== 'undefined' && showNewForm) { %>

          <div class="competitors-table-card">
            <h2 class="dashboard-section-title">Add New Judge</h2>

            <form action="/admin/judges" method="POST" class="competitor-inline-edit">

              <div class="competitor-form-field">
                <label for="new-username">Username</label>
                <input
                  type="text"
                  id="new-username"
                  name="username"
                  required
                >
              </div>

              <div class="competitor-form-field">
                <label for="new-password">Password</label>
                <input
                  type="password"
                  id="new-password"
                  name="password"
                  required
                >
              </div>

              <div class="competitor-form-buttons">
                <button type="submit" class="panel-primary-button">
                  <i class="fa-solid fa-check"></i>
                  Save Judge
                </button>

                <a href="/admin/judges" class="panel-action-button edit">
                  Cancel
                </a>
              </div>

            </form>
          </div>

        <% } %>

        <!-- Judges Table -->
        <div class="competitors-table-card">
          <table class="panel-table">
            <thead>
              <tr>
                <th>Username</th>
                <th>Role</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% judges.forEach((judge) => { %>

                <tr>
                  <% if (editJudge && editJudge._id.toString() === judge._id.toString()) { %>

                    <td colspan="3">
                      <form
                        action="/admin/judges/<%= judge._id %>/edit"
                        method="POST"
                        class="competitor-inline-edit"
                      >

                        <div class="competitor-form-field">
                          <label for="username-<%= judge._id %>">Username</label>
                          <input
                            type="text"
                            id="username-<%= judge._id %>"
                            name="username"
                            value="<%= judge.username %>"
                            required
                          >
                        </div>

                        <div class="competitor-form-field">
                          <label for="role-<%= judge._id %>">Role</label>
                          <input
                            type="text"
                            id="role-<%= judge._id %>"
                            value="Judge"
                            disabled
                          >
                        </div>

                        <div class="competitor-form-buttons">
                          <button type="submit" class="panel-primary-button">
                            <i class="fa-solid fa-check"></i>
                            Save
                          </button>

                          <a href="/admin/judges" class="panel-action-button edit">
                            Cancel
                          </a>
                        </div>

                      </form>
                    </td>

                  <% } else { %>

                    <td>
                      <div class="competitor-name">
                        <span class="competitor-avatar">
                          <i class="fa-solid fa-user"></i>
                        </span>
                        <strong><%= judge.username %></strong>
                      </div>
                    </td>

                    <td>Judge</td>

                    <td>
                      <div class="panel-actions">

                        <a
                          href="/admin/judges?edit=<%= judge._id %>"
                          class="panel-action-button edit"
                        >
                          <i class="fa-solid fa-pen"></i>
                          Edit
                        </a>

                        <form
                          action="/admin/judges/<%= judge._id %>/delete"
                          method="POST"
                          onsubmit="return confirm('Are you sure you want to delete this judge?')"
                        >
                          <button type="submit" class="panel-action-button delete">
                            <i class="fa-solid fa-trash"></i>
                            Delete
                          </button>
                        </form>

                      </div>
                    </td>

                  <% } %>
                </tr>

              <% }) %>

              <% if (judges.length === 0) { %>
                <tr>
                  <td colspan="3" class="panel-empty-state">
                    No judges have been created yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </main>
    </div>
  </div>
</body>
</html>