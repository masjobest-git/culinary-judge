<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/panel.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <title>Admin Panel | Culinary Judge</title>
</head>

<body class="admin-page">
  <div class="dashboard-layout">

    <aside class="dashboard-sidebar">
      <a href="/" class="dashboard-brand">
        <i class="fa-solid fa-utensils"></i>
        <span>Culinary Judge</span>
      </a>

      <p class="dashboard-menu-label">MAIN MENU</p>

      <a href="/admin" class="dashboard-nav-link active">
        <i class="fa-solid fa-house"></i>
        <span>Dashboard</span>
      </a>

      <a href="/competitors" class="dashboard-nav-link">
        <i class="fa-solid fa-users"></i>
        <span>Competitors</span>
      </a>

      <a href="/admin/judges" class="dashboard-nav-link">
        <i class="fa-solid fa-user-check"></i>
        <span>Judges</span>
      </a>

      <a href="/admin/scoring-groups" class="dashboard-nav-link">
        <i class="fa-solid fa-list-check"></i>
        <span>Scoring Groups</span>
      </a>

      <a href="/admin/ranking" class="dashboard-nav-link">
        <i class="fa-solid fa-trophy"></i>
        <span>Final Ranking</span>
      </a>

      <div class="dashboard-sidebar-spacer"></div>

      <a href="/" class="dashboard-nav-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Home</span>
      </a>

      <form action="/auth/logout" method="POST">
        <button type="submit" class="dashboard-nav-link dashboard-logout">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Logout</span>
        </button>
      </form>
    </aside>

    <div class="dashboard-main">

      <header class="dashboard-topbar">
        <div>
          <span class="dashboard-breadcrumb">Culinary Judge /</span>
          <strong> Admin Dashboard</strong>
        </div>

        <div class="dashboard-admin-label">
          <i class="fa-solid fa-user-shield"></i>
          <span>Administrator</span>
        </div>
      </header>

      <main class="dashboard-content">

        <div class="dashboard-welcome">
          <div>
            <p class="dashboard-eyebrow">ADMINISTRATION</p>
            <h1>Admin Dashboard</h1>
            <p>Manage competitors, judges, scoring criteria and competition results.</p>
          </div>

          <div class="dashboard-welcome-icon">
            <i class="fa-solid fa-chart-line"></i>
          </div>
        </div>

        <% if (errorMessage) { %>
          <p class="error-message"><%= errorMessage %></p>
        <% } %>

        <% if (successMessage) { %>
          <p class="success-message"><%= successMessage %></p>
        <% } %>

        <h2 class="dashboard-section-title">Competition Management</h2>

        <div class="dashboard-cards">

          <a href="/competitors" class="dashboard-card">
            <div class="dashboard-card-icon blue">
              <i class="fa-solid fa-users"></i>
            </div>
            <h3>Competitors</h3>
            <p>View and manage competition participants.</p>
            <span>View Competitors <i class="fa-solid fa-arrow-right"></i></span>
          </a>

          <a href="/admin/judges" class="dashboard-card">
            <div class="dashboard-card-icon purple">
              <i class="fa-solid fa-user-check"></i>
            </div>
            <h3>Judges</h3>
            <p>View and manage competition judges.</p>
            <span>View Judges <i class="fa-solid fa-arrow-right"></i></span>
          </a>

          <a href="/admin/scoring-groups" class="dashboard-card">
            <div class="dashboard-card-icon purple">
              <i class="fa-solid fa-list-check"></i>
            </div>
            <h3>Scoring Groups</h3>
            <p>Manage scoring groups and evaluation criteria.</p>
            <span>Manage Scoring Groups <i class="fa-solid fa-arrow-right"></i></span>
          </a>

          <a href="/admin/ranking" class="dashboard-card">
            <div class="dashboard-card-icon gold">
              <i class="fa-solid fa-trophy"></i>
            </div>
            <h3>Final Ranking</h3>
            <p>Review the final scores and ranking of competitors.</p>
            <span>View Final Ranking <i class="fa-solid fa-arrow-right"></i></span>
          </a>

        </div>

      </main>
    </div>
  </div>
</body>
</html>