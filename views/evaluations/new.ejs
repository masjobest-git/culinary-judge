<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/panel.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

  <title>Evaluate Competitor | Culinary Judge</title>
</head>

<body class="admin-page judge-page">

  <div class="dashboard-layout">

    <!-- Sidebar -->
    <aside class="dashboard-sidebar">

      <a href="/" class="dashboard-brand">
        <i class="fa-solid fa-utensils"></i>
        <span>Culinary Judge</span>
      </a>

      <p class="dashboard-menu-label">MAIN MENU</p>

      <a href="/judge" class="dashboard-nav-link">
        <i class="fa-solid fa-house"></i>
        <span>Dashboard</span>
      </a>

      <a href="/competitors" class="dashboard-nav-link active">
        <i class="fa-solid fa-users"></i>
        <span>Competitors</span>
      </a>

      <a href="/evaluations/results" class="dashboard-nav-link">
        <i class="fa-solid fa-clipboard-check"></i>
        <span>My Evaluation Results</span>
      </a>

      <div class="dashboard-sidebar-spacer"></div>

      <a href="/" class="dashboard-nav-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Home</span>
      </a>

      <form action="/auth/logout" method="POST">
        <button type="submit" class="dashboard-nav-link dashboard-logout">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Logout</span>
        </button>
      </form>

    </aside>

    <!-- Main content -->
    <div class="dashboard-main">

      <!-- Topbar -->
      <header class="dashboard-topbar">

        <div>
          <span class="dashboard-breadcrumb">Culinary Judge /</span>
          <strong>Evaluate Competitor</strong>
        </div>

        <div class="dashboard-admin-label">
          <i class="fa-solid fa-gavel"></i>
          <span>Judge Panel</span>
        </div>

      </header>

      <!-- Page content -->
      <main class="dashboard-content">

        <div class="dashboard-welcome">

          <div>
            <p class="dashboard-eyebrow">JUDGE WORKSPACE</p>
            <h1>Evaluate Competitor</h1>
            <p>Enter your points for each criterion.</p>
          </div>

          <div class="dashboard-welcome-icon">
            <i class="fa-solid fa-clipboard-check"></i>
          </div>

        </div>

        <!-- Competitor evaluation form -->
        <section class="judge-dashboard-card evaluation-page-card">

          <div class="evaluation-competitor-info">
            <h2><%= competitor.name %></h2>
            <p>School: <%= competitor.school %></p>
          </div>

          <form
            action="/evaluations/<%= competitor._id %>"
            method="POST"
            class="evaluation-form"
          >

            <!-- Dish category -->
            <div class="dish-category-card">

              <label for="dishCategory">Dish Category</label>

              <select id="dishCategory" name="dishCategory" required>
                <option value="">Select dish category</option>
                <option value="Appetizer">Appetizer</option>
                <option value="Main Course">Main Course</option>
                <option value="Dessert">Dessert</option>
              </select>

            </div>

            <!-- Hidden until a category is selected -->
            <div id="evaluationFields" style="display: none;">

              <!-- Scoring groups and criteria -->
              <% scoringGroups.forEach((group) => { %>

                <section class="evaluation-group">

                  <div class="evaluation-group-heading">
                    <h3><%= group.name %></h3>
                  </div>

                  <div class="evaluation-criteria">

                    <% group.criteria.forEach((criterion) => { %>

                      <div class="evaluation-criterion">

                        <label for="score-<%= criterion._id %>">
                          <span><%= criterion.name %></span>

                          <small>
                            Min: <%= criterion.minPoints %> ·
                            Max: <%= criterion.maxPoints %> points
                          </small>
                        </label>

                        <input
                          id="score-<%= criterion._id %>"
                          type="number"
                          name="scores[<%= criterion.name %>]"
                          min="<%= criterion.minPoints %>"
                          max="<%= criterion.maxPoints %>"
                          step="any"
                          required
                        >

                      </div>

                    <% }) %>

                  </div>

                </section>

              <% }) %>

              <!-- Form buttons -->
              <div class="evaluation-form-actions">

                <a href="/competitors" class="panel-action-button edit">
                  <i class="fa-solid fa-arrow-left"></i>
                  Back to Competitors
                </a>

                <button type="submit" class="panel-primary-button">
                  <i class="fa-solid fa-floppy-disk"></i>
                  Save Evaluation
                </button>

              </div>

            </div>

          </form>

        </section>

      </main>

    </div>

  </div>

  <script>
    const dishCategory = document.getElementById('dishCategory');
    const evaluationFields = document.getElementById('evaluationFields');

    dishCategory.addEventListener('change', function () {
      if (dishCategory.value !== '') {
        evaluationFields.style.display = 'block';
      } else {
        evaluationFields.style.display = 'none';
      }
    });
  </script>

</body>
</html>